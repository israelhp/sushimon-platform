# Copiar a .env (nunca versionar .env). Sin secretos reales aquí.
NODE_ENV=development
PORT=3001
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000
# Supabase (se usarán en el primer slice con base de datos; vacíos por ahora).
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_SERVICE_ROLE_KEY y DATABASE_URL: solo en el gestor de secretos del entorno; NUNCA en el frontend.
