# Copiar a .env (nunca versionar .env). Sin secretos reales aquí.
# Definir SIEMPRE explícito en despliegues: si falta y DATABASE_URL es remota, la API no arranca.
NODE_ENV=development
PORT=3001
LOG_LEVEL=log
# Orígenes permitidos por CORS, separados por coma. En producción nunca "*".
CORS_ORIGINS=http://localhost:3000

# --- Base de datos (Supabase PostgreSQL, esquema `app`) ---
# Runtime de la API: cadena del transaction pooler de Supabase (Project Settings → Database → Connection
# string → Transaction pooler, puerto 6543, con `?pgbouncer=true`). Copia la cadena desde Supabase.
# Solo en el gestor de secretos del entorno; vacío en desarrollo = la API arranca sin base de datos.
DATABASE_URL=
# Migraciones (`pnpm --filter sushimon-api db:migrate:deploy`): conexión directa o session pooler (5432).
# Nunca el transaction pooler. Solo local/CI de migraciones, no la usa la API en runtime.
DIRECT_URL=
# Pruebas de integración (`pnpm --filter sushimon-api test:integration`): PostgreSQL de pruebas (el proyecto
# Supabase de pruebas, con la misma cadena directa/session pooler 5432 que DIRECT_URL). NUNCA producción.
# Crean datos marcados (@sushimon.test) y los borran al terminar. Vacío = las pruebas se omiten.
DATABASE_URL_TEST=
# Conexiones por instancia (pequeño en serverless: cada instancia abre su propio pool).
# REQUISITO OPERATIVO en producción: DB_POOL_MAX >= 5. Con <= 3 los semáforos de tienda, cotización y pedidos (F17/F19/F20)
# suman el pool entero y dejan 0 conexiones a las rutas sin semáforo (auth, salud, backoffice). El defecto 3 es solo desarrollo.
DB_POOL_MAX=3
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
# Tope cliente por consulta en ms (1000-120000; vacío = 10000). No se usa statement_timeout: el transaction pooler lo rechaza.
DB_QUERY_TIMEOUT_MS=

# --- Rate limiting global (por IP, en memoria por instancia) ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Saltos de proxy de confianza (1 detrás de Vercel/Render/Fly) para tomar la IP real. 0 = ninguno.
TRUST_PROXY_HOPS=0
# BLOQUEANTE DE DESPLIEGUE: detrás de proxy/CDN debe ser >= 1 o el rate limit por IP (p. ej. /delivery-coverage/check)
# agrupa a todos los clientes bajo la IP del proxy. Ver docs/security/README.md.
# Con NODE_ENV=production y 0 la API arranca pero registra un warning.

# --- Horarios (F08) ---
# Zona IANA del negocio: los horarios semanales son hora local de esta zona. Vacío = America/Guatemala.
BUSINESS_TIMEZONE=America/Guatemala

# --- Cobertura de entrega (F09) ---
# Adaptador de cobertura de PedidosYa: `unavailable` (defecto; sin red, responde UNKNOWN/BLOCKED_EXTERNAL) o `mock`
# (simulación determinista SOLO para desarrollo/pruebas; con NODE_ENV=production la API NO arranca).
# PedidosYa real: pendiente de documentación y credenciales (F29); no hay variables de URL/token todavía.
# El mock solo arranca con NODE_ENV explícitamente development o test (cualquier otro valor => la API no arranca).
PEDIDOSYA_COVERAGE_ADAPTER=unavailable
# Solo con ADAPTER=mock: available | unavailable | unknown | timeout | provider_error | invalid_request (defecto unknown).
PEDIDOSYA_MOCK_SCENARIO=
# Tope técnico en ms del orquestador al consultar el adaptador (100-10000). No es un SLA de PedidosYa.
PEDIDOSYA_COVERAGE_TIMEOUT_MS=3000

# --- Productos (F11) ---
# Hosts permitidos para las URL de imágenes (lista separada por comas): `cdn.ejemplo.com` = coincidencia exacta;
# `.ejemplo.com` = cualquier subdominio. Vacía = cualquier host https público (IP literales, localhost y hostnames sin
# punto se rechazan SIEMPRE). F14 fijará el host de R2/CDN; la web debe restringir `img-src` por CSP (pendiente).
PRODUCT_MEDIA_ALLOWED_HOSTS=

# --- Medios en Cloudflare R2 (F14) ---
# SOLO SERVIDOR: estas variables NUNCA llevan el prefijo NEXT_PUBLIC_, no van al frontend, al repo, a los logs ni a las
# respuestas. En producción viven en el gestor de secretos del hosting de la API (ADR-0006). Sin valores reales aquí.
# Grupo TODO-O-NADA: (R2_ACCOUNT_ID o R2_ENDPOINT) + R2_BUCKET + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY +
# R2_PUBLIC_BASE_URL. Definir algunas pero no todas => la API NO arranca (el error nombra las que faltan, sin valores).
# Ninguna definida (por defecto) => almacenamiento no disponible: subir/confirmar/borrar responden 503
# MEDIA_STORAGE_UNAVAILABLE y el resto de la API funciona. R2 real: BLOCKED_EXTERNAL (ver docs/integrations/cloudflare-r2.md).
# Id de la cuenta de Cloudflare (construye https://<id>.r2.cloudflarestorage.com) o, alternativamente, el endpoint S3 https.
R2_ACCOUNT_ID=
R2_ENDPOINT=
# Bucket PÚBLICO de medios (3-63, minúsculas/dígitos/punto/guion).
R2_BUCKET=
# Token S3 de permisos mínimos sobre ese bucket (un token por entorno).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL pública https del dominio personalizado/CDN del bucket, SIN barra final ni query (no se inventa un dominio).
# El host se añade a PRODUCT_MEDIA_ALLOWED_HOSTS si esa lista no está vacía.
R2_PUBLIC_BASE_URL=
# Región SigV4 (vacío = auto).
R2_REGION=
# Tope por archivo en bytes: 1..5242880 (5 MiB; es también un CHECK de la BD, subirlo exige migración). Vacío = 5242880.
MEDIA_MAX_BYTES=
# Vigencia de la URL de subida firmada en segundos: 30..300. Vacío = 300.
MEDIA_UPLOAD_TTL_SECONDS=
# Opcional: r2 | mock. Vacío = r2 si el grupo R2 está completo; si no, no disponible. `mock` (memoria, host *.invalid, no
# sube nada real) solo con NODE_ENV=development|test explícito, sin variables R2; con production la API NO arranca.
MEDIA_STORAGE_ADAPTER=

# --- Checkout (F19) ---
# Secreto HMAC (>=32 caracteres) de la vigencia firmada de POST /v1/checkout/quote y de la huella de idempotencia de
# POST /v1/orders (F20). Vacío = quote.token null y POST /v1/orders => 503 ORDERS_UNAVAILABLE (fail-closed: es REQUISITO de
# runtime para crear pedidos). SECRETO de servidor: solo en el gestor de secretos; rotarlo invalida cotizaciones abiertas (<=10
# min) y las huellas de idempotencia vigentes (una repetición de <24 h con la misma clave devolvería 409 IDEMPOTENCY_KEY_REUSED).
CHECKOUT_QUOTE_SECRET=

# --- Health ---
# Token (>=16 caracteres) para GET /v1/health/ready (cabecera x-health-token). Obligatorio en producción.
HEALTH_READY_TOKEN=

# --- Supabase Auth (se usan en el slice de autenticación) ---
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Clave de servicio de Supabase (SECRETO de servidor): solo habilita POST /v1/admin/staff/{id}/mfa-reset (F02).
# Vacía = el reinicio de MFA responde 503 MFA_RESET_UNAVAILABLE. Definirla solo en el gestor de secretos del
# despliegue; NUNCA en el repo, en el frontend ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Tiempo máximo (ms) de cada llamada a la Admin API de Supabase Auth (500-30000; vacío = 8000).
SUPABASE_ADMIN_TIMEOUT_MS=
