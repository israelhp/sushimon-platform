// Esquema Prisma de Sushi Mon. La línea base relacional es docs/references/monsushi_dbdiagram.dbml
// (esquema PostgreSQL `app`). Los modelos se agregan por vertical slice, con su migración y revisión
// del database-engineer. F00 solo crea el esquema `app` y verifica la conexión.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ---------------------------------------------------------------------------------------------
// F01 · Identidad. `auth_user_id` referencia auth.users(id) (Supabase Auth); la FK se crea en SQL
// (migración 0002) solo si el esquema `auth` existe, porque Prisma no modela el esquema de Supabase.
// ---------------------------------------------------------------------------------------------

model Branch {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String                  @unique
  name             String
  phone            String?
  /// F07 (migración 0003). Obligatoria y no vacía (CHECK NOT VALID por filas previas a F07).
  address          String
  latitude         Decimal?                @db.Decimal(10, 7)
  longitude        Decimal?                @db.Decimal(10, 7)
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  assignments      StaffAssignment[]
  auditEvents      AuditEvent[]
  hours            BranchHour[]
  closures         BranchClosure[]
  deliveryZones    DeliveryZone[]
  deliverySettings BranchDeliverySettings?
  branchProducts   BranchProduct[]

  @@map("branches")
  @@schema("app")
}

/// F09 (migración 0007). Catálogo geográfico; solo lectura por API (cambia por migración).
model Department {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String         @unique(map: "departments_name_key")
  municipalities Municipality[]

  @@map("departments")
  @@schema("app")
}

/// F09 (migración 0007). El UNIQUE (department_id, name) sirve la consulta por departamento y la FK.
model Municipality {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId      String            @map("department_id") @db.Uuid
  name              String
  department        Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  deliveryZones     DeliveryZone[]
  customerAddresses CustomerAddress[]

  @@unique([departmentId, name], map: "municipalities_department_id_name_key")
  @@map("municipalities")
  @@schema("app")
}

/// F09 (migración 0007). Zona propia por sucursal. `zoneKey` la calcula la API (D6); `baseFee` es dinero exacto:
/// leer/escribir con `Prisma.Decimal` o `::text`, nunca `number`. CHECK (tarifa, coherencia label/key) solo en SQL.
model DeliveryZone {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  municipalityId String       @map("municipality_id") @db.Uuid
  zoneLabel      String?      @map("zone_label")
  zoneKey        String       @default("") @map("zone_key")
  baseFee        Decimal      @default(0) @map("base_fee") @db.Decimal(12, 2)
  active         Boolean      @default(true)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  @@unique([branchId, municipalityId, zoneKey], map: "delivery_zones_branch_municipality_zone_key")
  @@index([municipalityId], map: "delivery_zones_municipality_idx")
  @@map("delivery_zones")
  @@schema("app")
}

/// F09 (migración 0007). 1:1 con Branch; fila ausente = defaults (constante en la API, sin backfill).
/// `updatedAt` lo fija la API en el UPDATE (sin @updatedAt para mantener una sola fuente: SQL explícito).
model BranchDeliverySettings {
  branchId                String   @id @map("branch_id") @db.Uuid
  ownDeliveryZonesEnabled Boolean  @default(false) @map("own_delivery_zones_enabled")
  pedidosyaEnabled        Boolean  @default(true) @map("pedidosya_enabled")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  branch                  Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@map("branch_delivery_settings")
  @@schema("app")
}

/// F08 (migración 0006). Intervalo semiabierto [opensAt, closesAt) en hora de pared; `weekday` ISO (1=lunes … 7=domingo).
/// `closesAt` puede ser 24:00:00, que un `DateTime` de JS no representa: el repositorio lee/escribe esta tabla con
/// SQL crudo (`opens_at::text`, `$1::time`) y NO con el cliente tipado. CHECK y EXCLUDE (sin solapes) solo en SQL.
model BranchHour {
  branchId String   @map("branch_id") @db.Uuid
  weekday  Int      @db.SmallInt
  opensAt  DateTime @map("opens_at") @db.Time(0)
  closesAt DateTime @map("closes_at") @db.Time(0)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([branchId, weekday, opensAt])
  @@map("branch_hours")
  @@schema("app")
}

/// F08 (migración 0006). Cierre temporal [startsAt, endsAt); CHECK endsAt > startsAt y EXCLUDE de solapes en SQL.
/// `reason` es interno (nunca público).
model BranchClosure {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)
  reason   String?
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, startsAt, endsAt], map: "branch_closures_branch_starts_idx")
  @@map("branch_closures")
  @@schema("app")
}

model Customer {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String?            @unique @map("auth_user_id") @db.Uuid
  fullName   String             @map("full_name")
  email      String?
  phone      String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  addresses  CustomerAddress[]
  favorites  CustomerFavorite[]

  @@map("customers")
  @@schema("app")
}

/// F06 (0009). SIN relación a Product: products no existe aún; F11 añade la FK (NOT VALID + VALIDATE).
model CustomerFavorite {
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// FK añadida en 0012 (NOT VALID si había huérfanos al aplicarla).
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([customerId, productId], map: "customer_favorites_pkey")
  @@index([customerId, createdAt(sort: Desc), productId], map: "customer_favorites_customer_created_idx")
  @@index([productId], map: "customer_favorites_product_idx")
  @@map("customer_favorites")
  @@schema("app")
}

/// F10 (0011). Jerarquía de hasta 3 niveles; ciclos/profundidad los impone el trigger categories_enforce_hierarchy
/// (bloqueo advisory 1100110, ver migración). CHECK de slug/nombre/longitudes/sort_order solo en SQL.
model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  slug        String     @unique
  name        String
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// La mantiene la API en el UPDATE (sin trigger).
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, sortOrder, name, id], map: "categories_parent_sort_idx")
  @@map("categories")
  @@schema("app")
}

/// F11 (0012). CHECK de sku/slug/nombre/longitudes/precio solo en SQL.
model Product {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String?                @unique
  categoryId     String                 @map("category_id") @db.Uuid
  slug           String                 @unique
  name           String
  description    String?
  basePrice      Decimal                @map("base_price") @db.Decimal(12, 2)
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  /// La mantiene la API en el UPDATE (sin trigger).
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  media          ProductMedia[]
  favorites      CustomerFavorite[]
  modifierGroups ProductModifierGroup[]
  branchProducts BranchProduct[]

  @@index([categoryId, active, name, id], map: "products_category_active_name_idx")
  @@index([active, name, id], map: "products_active_name_idx")
  @@map("products")
  @@schema("app")
}

/// F11 (0012). UNIQUE (product_id, sort_order) es DEFERRABLE INITIALLY DEFERRED en SQL (Prisma no lo expresa: no usar
/// upsert/ON CONFLICT sobre él). Tope de 8 por producto: trigger product_media_limit_trg.
model ProductMedia {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String      @map("product_id") @db.Uuid
  mediaUrl  String      @map("media_url")
  altText   String?     @map("alt_text")
  sortOrder Int         @default(0) @map("sort_order")
  /// F14 (0015). NULL = medio con URL externa previa a F14. FK ON DELETE RESTRICT: un asset en uso no se borra.
  assetId   String?     @map("asset_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productId, sortOrder], map: "product_media_product_sort_key")
  @@index([assetId], map: "product_media_asset_idx")
  @@map("product_media")
  @@schema("app")
}

/// F12 (0013). UNIQUE sobre lower(btrim(name)) (índice modifier_groups_name_lower_key) no es expresable en Prisma:
/// el servicio captura 23505. CHECK: 0 <= min_select <= max_select <= 20, max_select >= 1.
model ModifierGroup {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  minSelect Int                    @default(0) @map("min_select") @db.SmallInt
  maxSelect Int                    @default(1) @map("max_select") @db.SmallInt
  active    Boolean                @default(true)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  /// La mantiene la API en el UPDATE (sin trigger).
  updatedAt DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@map("modifier_groups")
  @@schema("app")
}

/// F12 (0013). UNIQUE (group_id, sort_order) es DEFERRABLE INITIALLY DEFERRED en SQL (no usar upsert/ON CONFLICT).
/// UNIQUE (group_id, lower(btrim(name))) = índice modifiers_group_name_lower_key (no expresable). Tope de 30 por
/// grupo: trigger modifiers_limit_trg (23514, modifier_group_max_options). extra_price 0..9999.99 (CHECK).
model Modifier {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String        @map("group_id") @db.Uuid
  name       String
  extraPrice Decimal       @default(0) @map("extra_price") @db.Decimal(12, 2)
  active     Boolean       @default(true)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([groupId, sortOrder], map: "modifiers_group_sort_key")
  @@map("modifiers")
  @@schema("app")
}

/// F12 (0013). UNIQUE (product_id, sort_order) DEFERRABLE INITIALLY DEFERRED (no usar upsert). Tope de 10 grupos por
/// producto: trigger product_modifier_groups_limit_trg (23514, product_max_modifier_groups).
model ProductModifierGroup {
  productId String        @map("product_id") @db.Uuid
  groupId   String        @map("group_id") @db.Uuid
  sortOrder Int           @default(0) @map("sort_order")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, groupId])
  @@unique([productId, sortOrder], map: "product_modifier_groups_product_sort_key")
  @@index([groupId], map: "product_modifier_groups_group_idx")
  @@map("product_modifier_groups")
  @@schema("app")
}

model StaffUser {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL = empleado preregistrado que aún no inició sesión (ADR-0009). Se vincula una sola vez.
  authUserId   String?           @unique @map("auth_user_id") @db.Uuid
  fullName     String            @map("full_name")
  /// Siempre en minúsculas (CHECK en la migración).
  email        String            @unique
  active       Boolean           @default(true)
  /// Alta del registro (0005). Filas previas a F03: fecha de la migración.
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Momento del vínculo con Auth (0005). NULL en filas vinculadas antes de F03 (dato desconocido). CHECK: requiere authUserId.
  linkedAt     DateTime?         @map("linked_at") @db.Timestamptz(6)
  /// Quién preautorizó (0005). NULL = proceso manual/bootstrap/anterior a F03; ON DELETE SET NULL.
  createdBy    String?           @map("created_by") @db.Uuid
  creator      StaffUser?        @relation("StaffCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdStaff StaffUser[]       @relation("StaffCreatedBy")
  assignments  StaffAssignment[]
  mediaAssets  MediaAsset[]

  @@index([createdBy], map: "staff_users_created_by_idx")
  @@index([createdAt(sort: Desc)], map: "staff_users_created_at_idx")
  @@map("staff_users")
  @@schema("app")
}

model Role {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name        String
  /// Rol del sistema (0005): solo `admin`; sus permisos no son editables por la API.
  isSystem    Boolean           @default(false) @map("is_system")
  permissions RolePermission[]
  assignments StaffAssignment[]

  @@map("roles")
  @@schema("app")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  description String
  roles       RolePermission[]

  @@map("permissions")
  @@schema("app")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
  @@schema("app")
}

model StaffAssignment {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId  String    @map("staff_id") @db.Uuid
  roleId   String    @map("role_id") @db.Uuid
  /// NULL = todas las sucursales.
  branchId String?   @map("branch_id") @db.Uuid
  active   Boolean   @default(true)
  staff    StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])

  @@unique([staffId, roleId, branchId])
  @@map("staff_assignments")
  @@schema("app")
}

// ---------------------------------------------------------------------------------------------
// F07 · Auditoría (migración 0003). `actorId` es el id de staff_users pero SIN FK a propósito:
// el historial no debe bloquear ni desaparecer con el empleado. `entityId` es polimórfico.
// ---------------------------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  reason     String?
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_events_entity_idx")
  @@index([branchId, createdAt(sort: Desc)], map: "audit_events_branch_created_idx")
  @@map("audit_events")
  @@schema("app")
}

/// F05 (migración 0008). Dirección guardada del cliente. `isDefault` tiene un índice ÚNICO PARCIAL en SQL
/// (`customer_addresses_one_default_key`, WHERE is_default): como máximo una predeterminada por cliente. Prisma no
/// modela índices parciales; el CHECK y el índice viven solo en la migración. Sin borrado lógico (ADR-0014).
model CustomerAddress {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  municipalityId String       @map("municipality_id") @db.Uuid
  label          String
  zone           String?
  addressLine    String       @map("address_line")
  referenceNote  String?      @map("reference_note")
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt, id], map: "customer_addresses_customer_created_idx")
  @@index([municipalityId], map: "customer_addresses_municipality_id_idx")
  @@map("customer_addresses")
  @@schema("app")
}

/// F14 (migración 0015). Objetos subidos a Cloudflare R2. No expresable en Prisma: UNIQUE parcial (kind, checksum_sha256)
/// WHERE status='READY' (índice media_assets_ready_checksum_key; el servicio captura 23505), índice parcial de purga
/// (status, expires_at) WHERE status='PENDING' y CHECKs: kind, formato de object_key (sin '..' ni '//'), mime, tamaño
/// 1..5242880 (subir el tope exige migración), checksum hex64, status, READY => confirmed_at, PENDING => expires_at.
model MediaAsset {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             String
  objectKey        String         @unique @map("object_key")
  bucket           String
  mimeType         String         @map("mime_type")
  sizeBytes        BigInt         @map("size_bytes")
  checksumSha256   String         @map("checksum_sha256")
  status           String         @default("PENDING")
  createdByStaffId String?        @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt      DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdBy        StaffUser?     @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productMedia     ProductMedia[]

  @@index([createdAt(sort: Desc), id], map: "media_assets_created_idx")
  @@map("media_assets")
  @@schema("app")
}

/// F13 (migración 0014). Excepciones por sucursal: AUSENCIA de fila = disponible al precio base (la API borra la fila al
/// volver al estado por defecto). CHECK de price_override en la migración (NULL o 0 < p <= 999999.99). Sin stock numérico.
model BranchProduct {
  branchId      String   @map("branch_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  available     Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// La mantiene la API en el UPDATE (sin trigger).
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([branchId, productId])
  @@index([productId], map: "branch_products_product_idx")
  @@map("branch_products")
  @@schema("app")
}
