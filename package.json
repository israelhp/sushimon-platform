{
  "name": "sushimon-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Sushi Mon platform monorepo: sushimon-api (NestJS) + sushimon-web (Next.js).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter sushimon-api --filter sushimon-web dev",
    "dev:api": "pnpm --filter sushimon-api dev",
    "dev:web": "pnpm --filter sushimon-web dev",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:hooks",
    "test:hooks": "node --test .claude/hooks/*.test.mjs scripts/*.test.mjs",
    "build": "pnpm -r --if-present build",
    "contracts:generate": "pnpm --filter @sushimon/contracts generate",
    "contracts:check": "pnpm --filter @sushimon/contracts check",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm secrets:scan && pnpm claude:validate && pnpm build",
    "prepare": "husky",
    "claude:validate": "node scripts/validate-claude-config.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "yaml": "^2.8.0"
  }
}
