// Nota: los CHECK y los indices parciales del SQL original deben implementarse en migraciones.
// Sushi Mon - Modelo entidad-relacion DBML para dbdiagram.io
// Generado a partir del esquema PostgreSQL normalizado del proyecto.
// auth.users corresponde a los usuarios administrados por Supabase Auth.

Project SushiMon {
  database_type: "PostgreSQL"
  Note: "Pedidos web + backoffice de Sushi Mon"
}

Table auth.users {
  id uuid [pk]
}


Table app.branches {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
  phone text
  address text [not null]
  latitude numeric(10,7)
  longitude numeric(10,7)
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table app.branch_hours {
  branch_id uuid [not null]
  weekday smallint [not null]
  opens_at time [not null]
  closes_at time [not null]

  Indexes {
    (branch_id, weekday, opens_at) [pk]
  }
}

Table app.branch_closures {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_id uuid [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  reason text
}

Table app.departments {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, unique]
}

Table app.municipalities {
  id uuid [pk, default: `gen_random_uuid()`]
  department_id uuid [not null]
  name text [not null]

  Indexes {
    (department_id, name) [unique]
  }
}

Table app.delivery_zones {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_id uuid [not null]
  municipality_id uuid [not null]
  zone_label text
  base_fee numeric(12,2) [not null, default: 0]
  active boolean [not null, default: true]
}

Table app.customers {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id uuid [unique]
  full_name text [not null]
  email text
  phone text
  created_at timestamptz [not null, default: `now()`]
}

Table app.customer_addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  municipality_id uuid [not null]
  label text [not null]
  zone text
  address_line text [not null]
  reference_note text
  latitude numeric(10,7)
  longitude numeric(10,7)
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table app.staff_users {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id uuid [not null, unique]
  full_name text [not null]
  email text [not null, unique]
  active boolean [not null, default: true]
}

Table app.roles {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
}

Table app.permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  description text [not null]
}

Table app.role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table app.staff_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  staff_id uuid [not null]
  role_id uuid [not null]
  branch_id uuid
  active boolean [not null, default: true]

  Indexes {
    (staff_id, role_id, branch_id) [unique]
  }
}

Table app.categories {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid
  slug text [not null, unique]
  name text [not null]
  description text
  sort_order integer [not null, default: 0]
  active boolean [not null, default: true]
}

Table app.products {
  id uuid [pk, default: `gen_random_uuid()`]
  sku text [unique]
  category_id uuid [not null]
  slug text [not null, unique]
  name text [not null]
  description text
  base_price numeric(12,2) [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table app.product_media {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  media_url text [not null]
  alt_text text
  sort_order integer [not null, default: 0]
}

Table app.branch_products {
  branch_id uuid [not null]
  product_id uuid [not null]
  price_override numeric(12,2)
  available boolean [not null, default: true]

  Indexes {
    (branch_id, product_id) [pk]
  }
}

Table app.modifier_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  min_select smallint [not null, default: 0]
  max_select smallint [not null, default: 1]
}

Table app.modifiers {
  id uuid [pk, default: `gen_random_uuid()`]
  group_id uuid [not null]
  name text [not null]
  extra_price numeric(12,2) [not null, default: 0]
}

Table app.product_modifier_groups {
  product_id uuid [not null]
  group_id uuid [not null]

  Indexes {
    (product_id, group_id) [pk]
  }
}

Table app.customer_favorites {
  customer_id uuid [not null]
  product_id uuid [not null]

  Indexes {
    (customer_id, product_id) [pk]
  }
}

Table app.promotions {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [unique]
  name text [not null]
  kind text [not null]
  value numeric(12,2) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  dine_in_only boolean [not null, default: false]
  active boolean [not null, default: true]
}

Table app.promotion_branches {
  promotion_id uuid [not null]
  branch_id uuid [not null]

  Indexes {
    (promotion_id, branch_id) [pk]
  }
}

Table app.promotion_products {
  promotion_id uuid [not null]
  product_id uuid [not null]

  Indexes {
    (promotion_id, product_id) [pk]
  }
}

Table app.promotion_weekdays {
  promotion_id uuid [not null]
  weekday smallint [not null]
  starts_at time [not null]
  ends_at time [not null]

  Indexes {
    (promotion_id, weekday, starts_at) [pk]
  }
}

Table app.orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_number bigint [unique, increment]
  customer_id uuid
  branch_id uuid [not null]
  customer_name text [not null]
  customer_phone text [not null]
  customer_email text
  fulfillment_type text [not null]
  scheduled_for timestamptz
  notes text
  status text [not null, default: 'pending']
  subtotal numeric(12,2) [not null]
  discount_total numeric(12,2) [not null, default: 0]
  delivery_fee numeric(12,2) [not null, default: 0]
  total numeric(12,2) [not null]
  currency char(3) [not null, default: 'GTQ']
  placed_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.order_addresses {
  order_id uuid [pk]
  municipality_name text [not null]
  zone text
  address_line text [not null]
  reference_note text
  latitude numeric(10,7)
  longitude numeric(10,7)
}

Table app.order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_id uuid
  product_name text [not null]
  quantity integer [not null]
  unit_price numeric(12,2) [not null]
  line_discount numeric(12,2) [not null, default: 0]
  notes text
}

Table app.order_item_modifiers {
  id uuid [pk, default: `gen_random_uuid()`]
  order_item_id uuid [not null]
  modifier_id uuid
  modifier_name text [not null]
  quantity integer [not null, default: 1]
  unit_extra_price numeric(12,2) [not null]
}

Table app.order_promotions {
  order_id uuid [not null]
  promotion_id uuid [not null]
  amount numeric(12,2) [not null]

  Indexes {
    (order_id, promotion_id) [pk]
  }
}

Table app.order_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  old_status text
  new_status text [not null]
  changed_by uuid
  reason text
  changed_at timestamptz [not null, default: `now()`]
}

Table app.payment_methods {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
  active boolean [not null, default: true]
}

Table app.payments {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  method_id uuid [not null]
  amount numeric(12,2) [not null]
  status text [not null]
  provider text
  provider_reference text
  idempotency_key text [unique]
  created_at timestamptz [not null, default: `now()`]
}

Table app.refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  amount numeric(12,2) [not null]
  reason text [not null]
  provider_reference text
  approved_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table app.riders {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_id uuid [not null]
  full_name text [not null]
  phone text [not null]
  vehicle_type text
  license_plate text
  active boolean [not null, default: true]
}

Table app.deliveries {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, unique]
  rider_id uuid
  status text [not null, default: 'pending']
  assigned_at timestamptz
  picked_up_at timestamptz
  delivered_at timestamptz
  delivery_notes text
}

Table app.delivery_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  delivery_id uuid [not null]
  status text [not null]
  changed_by uuid
  changed_at timestamptz [not null, default: `now()`]
}

Table app.incident_types {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]
}

Table app.incidents {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  type_id uuid [not null]
  description text [not null]
  requested_resolution text
  status text [not null, default: 'received']
  assigned_to uuid
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
}

Table app.incident_items {
  incident_id uuid [not null]
  order_item_id uuid [not null]

  Indexes {
    (incident_id, order_item_id) [pk]
  }
}

Table app.incident_updates {
  id uuid [pk, default: `gen_random_uuid()`]
  incident_id uuid [not null]
  author_id uuid
  note text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table app.audit_events {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid
  branch_id uuid
  entity_type text [not null]
  entity_id uuid [not null]
  action text [not null]
  reason text
  old_values jsonb
  new_values jsonb
  created_at timestamptz [not null, default: `now()`]
}

Table app.notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid
  channel text [not null]
  destination text [not null]
  template_code text [not null]
  status text [not null, default: 'pending']
  provider_reference text
  created_at timestamptz [not null, default: `now()`]
  sent_at timestamptz
}

Table app.job_applications {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_id uuid
  applicant_name text [not null]
  phone text [not null]
  email text
  position text [not null]
  experience_level text
  message text
  status text [not null, default: 'new']
  created_at timestamptz [not null, default: `now()`]
}

Ref: app.branch_hours.branch_id > app.branches.id
Ref: app.branch_closures.branch_id > app.branches.id
Ref: app.municipalities.department_id > app.departments.id
Ref: app.delivery_zones.branch_id > app.branches.id
Ref: app.delivery_zones.municipality_id > app.municipalities.id
Ref: app.customers.auth_user_id > auth.users.id [delete: set null]
Ref: app.customer_addresses.customer_id > app.customers.id [delete: cascade]
Ref: app.customer_addresses.municipality_id > app.municipalities.id
Ref: app.staff_users.auth_user_id > auth.users.id
Ref: app.role_permissions.role_id > app.roles.id [delete: cascade]
Ref: app.role_permissions.permission_id > app.permissions.id [delete: cascade]
Ref: app.staff_assignments.staff_id > app.staff_users.id
Ref: app.staff_assignments.role_id > app.roles.id
Ref: app.staff_assignments.branch_id > app.branches.id
Ref: app.categories.parent_id > app.categories.id
Ref: app.products.category_id > app.categories.id
Ref: app.product_media.product_id > app.products.id [delete: cascade]
Ref: app.branch_products.branch_id > app.branches.id
Ref: app.branch_products.product_id > app.products.id
Ref: app.modifiers.group_id > app.modifier_groups.id
Ref: app.product_modifier_groups.product_id > app.products.id
Ref: app.product_modifier_groups.group_id > app.modifier_groups.id
Ref: app.customer_favorites.customer_id > app.customers.id [delete: cascade]
Ref: app.customer_favorites.product_id > app.products.id
Ref: app.promotion_branches.promotion_id > app.promotions.id [delete: cascade]
Ref: app.promotion_branches.branch_id > app.branches.id
Ref: app.promotion_products.promotion_id > app.promotions.id [delete: cascade]
Ref: app.promotion_products.product_id > app.products.id
Ref: app.promotion_weekdays.promotion_id > app.promotions.id [delete: cascade]
Ref: app.orders.customer_id > app.customers.id [delete: set null]
Ref: app.orders.branch_id > app.branches.id
Ref: app.order_addresses.order_id > app.orders.id [delete: restrict]
Ref: app.order_items.order_id > app.orders.id
Ref: app.order_items.product_id > app.products.id [delete: set null]
Ref: app.order_item_modifiers.order_item_id > app.order_items.id
Ref: app.order_item_modifiers.modifier_id > app.modifiers.id [delete: set null]
Ref: app.order_promotions.order_id > app.orders.id
Ref: app.order_promotions.promotion_id > app.promotions.id
Ref: app.order_status_history.order_id > app.orders.id
Ref: app.order_status_history.changed_by > app.staff_users.id
Ref: app.payments.order_id > app.orders.id
Ref: app.payments.method_id > app.payment_methods.id
Ref: app.refunds.payment_id > app.payments.id
Ref: app.refunds.approved_by > app.staff_users.id
Ref: app.riders.branch_id > app.branches.id
Ref: app.deliveries.order_id > app.orders.id
Ref: app.deliveries.rider_id > app.riders.id
Ref: app.delivery_status_history.delivery_id > app.deliveries.id
Ref: app.delivery_status_history.changed_by > app.staff_users.id
Ref: app.incidents.order_id > app.orders.id
Ref: app.incidents.type_id > app.incident_types.id
Ref: app.incidents.assigned_to > app.staff_users.id
Ref: app.incident_items.incident_id > app.incidents.id [delete: cascade]
Ref: app.incident_items.order_item_id > app.order_items.id
Ref: app.incident_updates.incident_id > app.incidents.id
Ref: app.incident_updates.author_id > app.staff_users.id
Ref: app.audit_events.actor_id > app.staff_users.id
Ref: app.audit_events.branch_id > app.branches.id
Ref: app.notifications.order_id > app.orders.id
Ref: app.job_applications.branch_id > app.branches.id
