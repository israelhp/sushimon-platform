# Copiar a .env.local (nunca versionar). Solo variables NEXT_PUBLIC_* son visibles al navegador: sin secretos.
# Fuente de datos: "mock" (UI First, sin red) o "http" (API NestJS).
NEXT_PUBLIC_DATA_SOURCE=mock
# Escenario de Mock Data (ver src/mocks/scenarios).
NEXT_PUBLIC_MOCK_SCENARIO=default
# URL base de la API (obligatoria con DATA_SOURCE=http).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Solo para demos al cliente: permite mock con NODE_ENV=production. En otro caso, el arranque falla.
NEXT_PUBLIC_ALLOW_MOCK_IN_PRODUCTION=false

# --- Autenticación (F01) ---
# "mock" = sesión de demostración (Etapa 1); "supabase" = Supabase Auth real con Google (PKCE).
# "supabase" exige NEXT_PUBLIC_DATA_SOURCE=http y que la API esté configurada con el mismo proyecto.
NEXT_PUBLIC_AUTH_SOURCE=mock
# Solo valores PÚBLICOS: URL del proyecto y clave publishable (nunca la service role ni el secreto de Google).
# Local (pnpm db:local:start): http://127.0.0.1:54341 y la PUBLISHABLE_KEY de `pnpm db:local:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
