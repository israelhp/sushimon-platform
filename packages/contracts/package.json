{
  "name": "@sushimon/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contrato HTTP canónico (OpenAPI) y tipos TypeScript generados para API y web.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
